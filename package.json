{
  "name": "@zerosnow/pi-zero",
  "version": "0.2.4",
  "description": "Curated pi extension suite: powerline status bar + random vibe + token/elapsed-time stats, /context, and ccstyle tool rendering",
  "type": "module",
  "author": "hotsnow (zerosnow)",
  "homepage": "https://github.com/hotsnow-sean/pi-zero#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hotsnow-sean/pi-zero.git"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "status-bar",
    "powerline",
    "vibe"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "context/",
    "powerline/",
    "shared/",
    "vibe/",
    "ccstyle/",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "pi-compact-thinking": "^0.2.0"
  },
  "bundledDependencies": [
    "pi-compact-thinking"
  ],
  "optionalDependencies": {
    "@shikijs/cli": "^4.4.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
